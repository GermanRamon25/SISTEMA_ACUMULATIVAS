<UserControl x:Class="SISTEMA_ACUMULATIVAS.Views.AcumuladosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="#F8FAFC" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Sombra suave y profesional para tarjetas -->
        <DropShadowEffect x:Key="CardShadow" Color="#94A3B8" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.15"/>
        <DropShadowEffect x:Key="BarShadow" Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="5" Opacity="0.2"/>

        <!-- Estilo para Encabezados del DataGrid -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <!-- Estilo para Filas del DataGrid con Selección Clara -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0369A1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,15,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- ==================== FILA 0: TARJETAS KPI Y BOTÓN ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Umbral UMA -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15,12" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="ALERTA (IDENTIFICACIÓN)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblMontoLimite" Text="8,000 UMAs ($905,120.00)" FontSize="18" FontWeight="ExtraBold" Foreground="#0284C7" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- KPI 2: Clientes en Alerta -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="15,12" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="ALERTAS ACTIVAS (REBASE)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblTotalAlertas" Text="0 Clientes" FontSize="18" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- KPI 3: UMA Diaria Oficial -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="15,12" Margin="0,0,15,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="VALOR DIARIO UMA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblInfoUma" Text="Umbrales (UMA Actual: $113.14)" FontSize="18" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Botón de Actualizar -->
            <Button x:Name="btnActualizar" Grid.Column="3" 
                    Content="🔄 Actualizar Datos" 
                    Height="46" Width="170"
                    Background="#0284C7" Foreground="White" 
                    FontWeight="Bold" FontSize="13" 
                    BorderThickness="0" Cursor="Hand"
                    Click="btnActualizar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- ==================== FILA 1: GRÁFICAS CORPORATIVAS ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Gráfica Izquierda: Clientes Prioritarios -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Análisis de Acumulación por Cliente" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Incluye Top 10 + Todo cliente que exceda el umbral (6 meses)" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- GRÁFICA MANUAL ESTILO PROGRESS BAR -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ListaGraficaClientes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,10,18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <!-- Barra más elegante -->
                                        </Grid.RowDefinitions>

                                        <!-- Encabezados de la barra -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Monto, StringFormat='C0'}" 
                                                       FontWeight="ExtraBold" Foreground="{Binding ColorTextoMonto}" FontSize="13"
                                                       DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding NombreCliente}" 
                                                       Foreground="#334155" FontWeight="SemiBold" FontSize="12"/>
                                        </DockPanel>

                                        <!-- Track de fondo (Gris claro) -->
                                        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="6" HorizontalAlignment="Stretch"/>

                                        <!-- Barra de progreso dinámica con degradado y sombra -->
                                        <Border Grid.Row="1" Background="{Binding ColorBarra}" 
                                                CornerRadius="6" HorizontalAlignment="Left"
                                                Width="{Binding AnchoBarraVirtual}"
                                                Effect="{StaticResource BarShadow}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Gráfica Derecha: Operaciones por Tipo -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,15">
                        <Button x:Name="btnVerGlobal" DockPanel.Dock="Right" 
                                Content="✕ Ver Global" 
                                Height="28" Padding="12,0"
                                Background="#F1F5F9" Foreground="#475569" 
                                FontWeight="Bold" FontSize="11" 
                                BorderThickness="0" Cursor="Hand"
                                Visibility="Collapsed"
                                Click="btnVerGlobal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <StackPanel>
                            <TextBlock x:Name="txtTituloPastel" Text="Distribución de Actividades Vulnerables" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Frecuencia global de operaciones en el periodo" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- GRÁFICA DE OPERACIONES -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ListaGraficaOperaciones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,10,18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Texto de la operación -->
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                                                   Text="{Binding TipoOperacion}" 
                                                   TextWrapping="Wrap" Foreground="#475569" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>

                                        <!-- Track de fondo -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="#F1F5F9" CornerRadius="6"/>

                                        <!-- Barra de frecuencia -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="{Binding ColorBarra}" 
                                                CornerRadius="6" HorizontalAlignment="Left"
                                                Width="{Binding AnchoBarraVirtual}"
                                                Effect="{StaticResource BarShadow}"/>

                                        <!-- Círculo indicador con el contador -->
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5"
                                                CornerRadius="20" Width="34" Height="34" 
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Cantidad}" 
                                                       FontWeight="ExtraBold" Foreground="#0F172A" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FILA 2: TABLA DE ALERTAS Y SEGUIMIENTO ==================== -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Seguimiento Detallado de Clientes" 
                               FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <TextBlock Text=" (Seleccione un cliente para ver sus operaciones)" 
                               FontSize="12" FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="dgAlertas" Grid.Row="1"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single"
                          GridLinesVisibility="None"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          RowHeaderWidth="0"
                          SelectionChanged="dgAlertas_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cliente o Razón Social" Binding="{Binding ClienteNombre}" Width="*"/>
                        <DataGridTextColumn Header="Acumulado" Binding="{Binding MontoAcumulado, StringFormat='C'}" Width="160"/>
                        <DataGridTextColumn Header="% Umbral" Binding="{Binding PorcentajeUmbral, StringFormat='{}{0:P0}'}" Width="100"/>
                        <DataGridTemplateColumn Header="Estado de Alerta" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="15" Padding="12,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoAlerta}" Value="⚠️ UMBRAL ALCANZADO">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstadoAlerta}" Value="Cerca del Límite">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding EstadoAlerta}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstadoAlerta}" Value="⚠️ UMBRAL ALCANZADO">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EstadoAlerta}" Value="Cerca del Límite">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Última Actividad" Binding="{Binding UltimaActualizacion, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>