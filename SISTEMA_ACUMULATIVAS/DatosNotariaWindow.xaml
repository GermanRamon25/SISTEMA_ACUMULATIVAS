<Window x:Class="SISTEMA_ACUMULATIVAS.DatosNotariaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datos de la Notaría" Height="520" Width="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="#F4F6F9" CornerRadius="12" BorderBrush="#1F364D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1F364D" CornerRadius="11,11,0,0">
                <Grid Margin="15,0">
                    <TextBlock Text="Datos de la Notaría" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Click="BtnCerrar_Click"/>
                </Grid>
            </Border>

            <!-- Formulario -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,15,20,10">
                <StackPanel>
                    <TextBlock Text="Nombre Completo" Foreground="#334155" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox x:Name="txtNombreTitular" Height="35" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

                    <TextBlock Text="Número de Notaría" Foreground="#334155" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox x:Name="txtNumeroNotaria" Height="35" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

                    <TextBlock Text="Dirección Completa" Foreground="#334155" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox x:Name="txtDireccion" Height="35" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

                    <TextBlock Text="Teléfono (10 dígitos)" Foreground="#334155" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox x:Name="txtTelefono" Height="35" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

                    <TextBlock Text="Email de Contacto" Foreground="#334155" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox x:Name="txtEmail" Height="35" Margin="0,0,0,18" VerticalContentAlignment="Center" Padding="8,0"/>

                    <Button x:Name="btnGuardar" Content="GUARDAR Y SINCRONIZAR" Background="#1F364D" Foreground="White" Height="42" FontWeight="Bold" Click="BtnGuardar_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer / Cancelar -->
            <Button Grid.Row="2" Content="Cancelar" Foreground="#D9534F" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Click="BtnCerrar_Click"/>
        </Grid>
    </Border>
</Window>