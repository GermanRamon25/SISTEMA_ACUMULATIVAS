<Window x:Class="SISTEMA_ACUMULATIVAS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SISTEMA_ACUMULATIVAS"
        xmlns:views="clr-namespace:SISTEMA_ACUMULATIVAS.Views"  mc:Ignorable="d"
        Title="Sistema de Acumulados - Notaría" 
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A2332">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" Direction="270" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Imagen del Logo -->
                    <Image Source="/Images/LOGO.ACUMULATIVAS.png" 
                      Width="38" 
                      Height="38" 
                      Margin="0,0,12,0" 
                      VerticalAlignment="Center" 
                      RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SISTEMA DE ACUMULATIVAS AG" 
                        Foreground="White" FontSize="18" FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtBannerNotaria" 
                           Text="NOTARÍA PÚBLICA" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#FFD4AF37" 
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Usuario Actual -->
                    <Border Background="#33FFFFFF" CornerRadius="15" Padding="15,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblUsuarioActual" Text="Cargando..." 
                                       Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Botón Configuración de Notaría -->
                    <Button x:Name="btnConfiguracionNotaria" Content="⚙️ Datos Notaría"
                            Background="#FF2B5278" Foreground="White"
                            BorderBrush="#FF4A7A9F" BorderThickness="1"
                            Padding="12,5" Margin="0,0,10,0" Cursor="Hand"
                            Click="btnConfiguracionNotaria_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botón Cerrar Sesión -->
                    <Button x:Name="btnCerrarSesion" Content="Cerrar Sesión"
                            Background="#FF343A40" Foreground="White"
                            BorderBrush="#FF495057" BorderThickness="1"
                            Padding="15,5" Cursor="Hand"
                            Click="btnCerrarSesion_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="10" BorderThickness="0" Background="Transparent">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="20,10" Background="Transparent" 
                                        BorderBrush="Transparent" BorderThickness="0,0,0,3" Margin="0,0,5,0">
                                    <ContentPresenter ContentSource="Header" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.FontSize="14" 
                                                      TextElement.FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF1B3A57"/>
                                        <Setter Property="Foreground" Value="#FF1B3A57"/>
                                        <Setter TargetName="Border" Property="Background" Value="#111B3A57"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#FF6C757D"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FF1B3A57"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="CLIENTES">
                <views:ClienteView Loaded="ClienteView_Loaded" />
            </TabItem>

            <TabItem Header="OPERACIONES">
                <views:OperacionesView />
            </TabItem>

            <TabItem Header="ACUMULADOS Y ALERTAS">
                <views:AcumuladosView />
            </TabItem>

            <TabItem Header="AVISO UIF">
                <views:AvisoUifView />
            </TabItem>

            <TabItem x:Name="tabPanelControl" Header="⚙️ Ajustes Generales">
                <views:PanelControlView />
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Background="#1A2332">
            <Grid Margin="15,0">
                <TextBlock x:Name="lblConexion" Text="● Sistema Conectado y Seguro" 
                           Foreground="#FF28A745" FontSize="12" FontWeight="Bold" 
                           VerticalAlignment="Center"/>

                <TextBlock Text="SISTEMA DE GESTIÓN NOTARIAL v1.0" 
                           Foreground="#88FFFFFF" FontSize="11" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>