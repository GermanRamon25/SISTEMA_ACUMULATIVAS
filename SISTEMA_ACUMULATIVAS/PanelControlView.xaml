<UserControl x:Class="SISTEMA_ACUMULATIVAS.Views.PanelControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="White" Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <TextBlock Text="AJUSTES DEL SISTEMA Y RESPONSABILIDAD LEGAL" FontSize="24" FontWeight="Bold" Foreground="#D4A843" Margin="0,0,0,20"/>

        <TabControl Margin="0,40,0,0">

            <!-- 1. CONFIGURACIÓN GENERAL -->
            <TabItem Header="Configuración General">
                <StackPanel Margin="20">
                    <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠️" FontSize="28" VerticalAlignment="Top" Margin="0,2,15,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="Bold" Foreground="#856404" FontSize="13" Text="AVISO DE RESPONSABILIDAD LEGAL (LFPIORPI):" Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#856404" FontSize="12.5" LineHeight="18" Text="La modificación del valor de la UMA, así como la gestión y adición de tipos de operaciones o sus criterios de aviso obligatorio, impactan directamente en el cumplimiento normativo para la prevención de lavado de dinero." Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#856404" FontSize="12.5" LineHeight="18" Text="El Notario Público titular y el personal autorizado asumen la estricta responsabilidad de verificar que los parámetros configurados coincidan exactamente con la legislación vigente y las publicaciones oficiales del INEGI y la UIF."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Valor de la UMA (Actualizable)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="$" FontSize="18" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtUMA" Width="100" FontSize="16" Padding="5" Margin="5,0,10,0"/>
                        <Button x:Name="btnGuardarUMA" Content="Guardar Nuevo Valor" 
                                Background="#FF007BFF" Foreground="White" Padding="15,5" 
                                BorderThickness="0" Cursor="Hand" Click="btnGuardarUMA_Click"/>
                    </StackPanel>
                    <TextBlock Text="Nota: Este cambio afecta inmediatamente a todos los registros y avisos de la notaría." 
                               Foreground="Gray" FontStyle="Italic" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 2. CATÁLOGO DE OPERACIONES -->
            <TabItem Header="Catálogo de Operaciones (LFPIORPI)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Nombre del Nuevo Tipo de Operación:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtNuevaOperacion" Padding="8" FontSize="13"/>
                            </StackPanel>
                            <CheckBox x:Name="chkAvisoObligatorio" Grid.Column="1" 
                                      Content="Aviso UIF Obligatorio (Sin importar umbral)" 
                                      VerticalAlignment="Bottom" Margin="0,0,15,10" FontWeight="SemiBold" Foreground="#DC2626"/>
                            <Button x:Name="btnGuardarOperacion" Grid.Column="2" Content="➕ Guardar Operación" 
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="15,8" 
                                    VerticalAlignment="Bottom" BorderThickness="0" Cursor="Hand" Click="btnGuardarOperacion_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="btnEliminarOperacion" Content="🗑️ Eliminar Operación Seleccionada" 
                                Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="12,6" 
                                BorderThickness="0" Cursor="Hand" Click="btnEliminarOperacion_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="dgCatalogoOperaciones" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Tipo de Operación" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTemplateColumn Header="¿Aviso Obligatorio?" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TextoObligatorio}" Foreground="{Binding ColorObligatorio}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 3. PAPELERA DE CLIENTES -->
            <TabItem Header="Papelera de Reciclaje (Clientes)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="btnRefrescarPapelera" Content="🔄 Refrescar Lista" Click="btnRefrescarPapelera_Click" Margin="0,0,10,0"
                           Background="#FF28A745" Foreground="White" FontWeight="Bold" Padding="10,5"/>
                        <Button x:Name="btnRestaurar" Content="♻️ Restaurar Cliente Seleccionado" 
                                Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,5"
                                BorderThickness="0" Click="btnRestaurar_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgPapelera" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="RFC" Binding="{Binding RFC}" Width="150"/>
                            <DataGridTextColumn Header="Fecha Eliminado (Aprox)" Binding="{Binding UltimaActualizacion}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 4. NUEVA PESTAÑA: EXPEDIENTE ÚNICO -->
            <TabItem Header="Expediente Único (Cliente)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buscador -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Buscar Historial de Cliente (Nombre o RFC):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="txtBuscarClienteExp" Padding="8" FontSize="13" TextChanged="txtBuscarClienteExp_TextChanged"/>
                            <Popup x:Name="popupClientesExp" PlacementTarget="{Binding ElementName=txtBuscarClienteExp}" Placement="Bottom" IsOpen="False" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" MaxHeight="200" MinWidth="{Binding ActualWidth, ElementName=txtBuscarClienteExp}">
                                    <ListBox x:Name="lstClientesExp" BorderThickness="0" SelectionChanged="lstClientesExp_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="5">
                                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RFC, StringFormat='RFC: {0}'}" FontSize="11" Foreground="#2563EB"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- Tarjetón de Resumen -->
                    <Border Grid.Row="1" x:Name="pnlResumenExpediente" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="PERFIL DEL CLIENTE:" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                <TextBlock x:Name="lblExpNombre" Text="---" FontWeight="Bold" FontSize="18" Foreground="#0369A1" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="lblExpRFC" Text="RFC: ---" FontSize="13" Foreground="#0284C7" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Total Escrituras/Operaciones" FontSize="11" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblExpTotalOps" Text="0" FontWeight="Bold" FontSize="22" Foreground="#0369A1" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Monto Acumulado Histórico" FontSize="11" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="lblExpMontoTotal" Text="$0.00" FontWeight="Bold" FontSize="22" Foreground="#15803D" HorizontalAlignment="Right"/>
                                <!-- BOTÓN DE DESCARGA PDF -->
                                <Button x:Name="btnDescargarExpediente" Content="📄 Descargar Reporte PDF" 
                                        Background="#0F172A" Foreground="White" FontWeight="Bold" Padding="15,6" Margin="0,10,0,0" 
                                        Cursor="Hand" BorderThickness="0" HorizontalAlignment="Right" 
                                        Click="btnDescargarExpediente_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Historial Detallado -->
                    <DataGrid Grid.Row="2" x:Name="dgExpedienteOperaciones" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E2E8F0" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaOperacion, StringFormat='dd/MM/yyyy'}" Width="100"/>
                            <DataGridTextColumn Header="No. Escritura" Binding="{Binding FolioEscritura}" Width="110"/>
                            <DataGridTextColumn Header="Tipo de Operación" Binding="{Binding TipoOperacion}" Width="*"/>
                            <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat='C'}" Width="130"/>
                            <DataGridTextColumn Header="Responsable" Binding="{Binding Usuario}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 5. BITÁCORA DE SEGURIDAD -->
            <TabItem Header="Bitácora de Seguridad (Logs)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 Actualizar Bitácora" Click="btnActualizarLogs_Click" HorizontalAlignment="Left" Padding="12,6" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgLogs" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E2E8F0" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="160"/>
                            <DataGridTextColumn Header="Usuario Responsable" Binding="{Binding Usuario}" Width="140"/>
                            <DataGridTemplateColumn Header="Acción Realizada" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccionAmigable}" Foreground="{Binding ColorAccion}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detalle de la Transacción" Binding="{Binding Detalle}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>