<UserControl x:Class="SISTEMA_ACUMULATIVAS.Views.AvisoUifView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F1F5F9" Loaded="UserControl_Loaded">

    <!-- RECURSOS CON EL CONVERTIDOR CORREGIDO -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR DE BÚSQUEDA Y ACCIÓN -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="15,12" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filtros de fecha -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Periodo a Revisar:" VerticalAlignment="Center" FontWeight="SemiBold" 
                               Foreground="#334155" FontSize="13" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbMes" SelectedIndex="7" Width="140" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="ENERO" Tag="1"/>
                        <ComboBoxItem Content="FEBRERO" Tag="2"/>
                        <ComboBoxItem Content="MARZO" Tag="3"/>
                        <ComboBoxItem Content="ABRIL" Tag="4"/>
                        <ComboBoxItem Content="MAYO" Tag="5"/>
                        <ComboBoxItem Content="JUNIO" Tag="6"/>
                        <ComboBoxItem Content="JULIO" Tag="7"/>
                        <ComboBoxItem Content="AGOSTO" Tag="8"/>
                        <ComboBoxItem Content="SEPTIEMBRE" Tag="9"/>
                        <ComboBoxItem Content="OCTUBRE" Tag="10"/>
                        <ComboBoxItem Content="NOVIEMBRE" Tag="11"/>
                        <ComboBoxItem Content="DICIEMBRE" Tag="12"/>
                    </ComboBox>
                    <ComboBox x:Name="cmbAnio" Width="90" Height="32" Padding="6,4" 
                              VerticalContentAlignment="Center"/>

                    <Button x:Name="btnBuscar" Content="🔍 Buscar Avisos" 
                            Margin="12,0,0,0" Height="32" Padding="15,0" 
                            Background="#0284C7" Foreground="#FFFFFF"
                            FontWeight="SemiBold" FontSize="12.5" BorderThickness="0" 
                            Cursor="Hand" Click="btnBuscar_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Botón de impresión nativo -->
                <Button x:Name="btnImprimir" Grid.Column="1"
                        Height="34" Padding="16,0" 
                        Background="#0F172A" Foreground="#FFFFFF"
                        FontWeight="SemiBold" FontSize="12.5" BorderThickness="0" 
                        Cursor="Hand" Click="btnImprimir_Click" IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖨️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Descargar / Imprimir Ficha" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- PANEL DE CONTENIDO (TABLA + VISOR NATIVO WPF) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de clientes con avisos -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,8,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Clientes Sujetos a Aviso (LFPIORPI)" 
                               FontSize="14" FontWeight="Bold" Foreground="#DC2626" Margin="4,2,0,10"/>
                    <DataGrid x:Name="dgClientesAviso" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionMode="Single" SelectionChanged="dgClientesAviso_SelectionChanged"
                              BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="*"/>
                            <DataGridTextColumn Header="Monto Acumulado" Binding="{Binding MontoTotalAcumulado, StringFormat=C}" Width="120"/>
                            <DataGridTextColumn Header="Criterio" Binding="{Binding MotivoAviso}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Visor Nativo de Hoja de Papel en WPF -->
            <Border Grid.Column="1" Background="#525659" CornerRadius="8" Margin="8,0,0,0" 
                    BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <!-- Instrucción inicial -->
                    <StackPanel x:Name="txtInstruccion" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="Seleccione un cliente de la lista para generar la Ficha Técnica." 
                                   Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Hoja de Papel Digital -->
                    <ScrollViewer x:Name="scrollFicha" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                        <Border x:Name="hojaImpresion" Width="740" Background="#FFFFFF" Padding="35" CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>

                            <StackPanel>
                                <!-- ENCABEZADO -->
                                <TextBlock x:Name="txtFichaTituloNotaria" Text="NOTARÍA PÚBLICA NO. ---" 
                                           FontSize="17" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ficha Informativa de Operación Vulnerable y Acumulación" 
                                           FontSize="13" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <TextBlock x:Name="txtFichaDireccion" Text="Ubicación | Control Interno LFPIORPI" 
                                           FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,12"/>

                                <Border Height="2" Background="#0284C7" Margin="0,0,0,15"/>

                                <!-- FUNDAMENTO LEGAL -->
                                <Border Background="#F8FAFC" BorderBrush="#0284C7" BorderThickness="4,0,0,0" Padding="10,8" Margin="0,0,0,15">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#334155" LineHeight="16">
                                        <Bold>FUNDAMENTO LEGAL (LFPIORPI):</Bold><LineBreak/>
                                        Conforme a lo dispuesto por el artículo 17, fracción XII, y artículo 18 de la Ley Federal para la Prevención e Identificación de Operaciones con Recursos de Procedencia Ilícita, así como los artículos 27 y 30 de sus Reglas de Carácter General, se emite la presente ficha técnica relativa al registro de actos, acumulación de montos y seguimiento de umbrales en Unidades de Medida y Actualización (UMA).
                                    </TextBlock>
                                </Border>

                                <!-- DATOS DEL CLIENTE -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="Otorgante / Razón Social:" FontWeight="Bold" FontSize="11.5" Foreground="#475569"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                            <TextBlock x:Name="txtFichaCliente" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A"/>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="RFC / CURP:" FontWeight="Bold" FontSize="11.5" Foreground="#475569"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                            <TextBlock x:Name="txtFichaRfcCurp" FontSize="11.5" Foreground="#0F172A"/>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="Monto Total Acumulado (6 Meses):" FontWeight="Bold" FontSize="11.5" Foreground="#475569"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                            <TextBlock x:Name="txtFichaMonto" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                                        </Border>

                                        <Border Grid.Row="3" Grid.Column="0" Background="#F8FAFC" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                            <TextBlock Text="Motivo / Criterio del Aviso:" FontWeight="Bold" FontSize="11.5" Foreground="#475569"/>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="1" Padding="8,6">
                                            <TextBlock x:Name="txtFichaCriterio" FontWeight="Bold" FontSize="11.5" Foreground="#DC2626"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- TABLA DE DESGLOSE DE OPERACIONES -->
                                <TextBlock Text="Desglose de Operaciones en el Periodo" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <DataGrid x:Name="dgOperacionesFicha" AutoGenerateColumns="False" IsReadOnly="True" 
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF" Margin="0,0,0,15">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaOperacion, StringFormat=dd/MM/yyyy}" Width="95"/>
                                        <DataGridTextColumn Header="No.Escritura" Binding="{Binding FolioEscritura}" Width="80"/>
                                        <DataGridTemplateColumn Header="Tipo de Operación Notarial" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,2">
                                                        <TextBlock Text="{Binding TipoOperacion}" FontSize="11.5" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding EtiquetaDetonante, StringFormat=[{0}]}" 
                                                                   Foreground="#DC2626" FontSize="10" FontWeight="Bold"
                                                                   Visibility="{Binding EsDetonante, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C}" FontWeight="Bold" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- DISPOSICIÓN SPPLD -->
                                <Border Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="4,0,0,0" Padding="10,8" Margin="0,0,0,25">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7F1D1D" LineHeight="16">
                                        <Bold>DISPOSICIÓN PARA PRESENTACIÓN DE AVISO (PORTAL SPPLD):</Bold><LineBreak/>
                                        La presente ficha técnica certifica que el monto o la naturaleza del acto notarial actualiza la obligación de emitir el Aviso correspondiente a través del Portal de Prevención de Lavado de Dinero (SPPLD - SAT). El aviso deberá formalizarse a más tardar el <Bold>día 17 del mes inmediato siguiente</Bold> a la fecha del instrumento notarial. La información descrita ha sido validada contra el protocolo notarial.
                                    </TextBlock>
                                </Border>

                                <!-- FIRMA Y PIE DE PÁGINA -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Border Width="240" Height="1" Background="#64748B" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtFichaTitularFirma" Text="LIC. ---" 
                                               FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtFichaSubtituloFirma" Text="Notario Público Titular No. ---" 
                                               FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Border Height="1" Background="#E2E8F0" Margin="0,20,0,5"/>
                                <TextBlock Text="2026 SISTEMA DE ACUMULATIVAS | Control de Umbrales y Acumulaciones Notariales" 
                                           FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>